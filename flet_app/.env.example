# Copy this file to `.env` (next to main.py) and fill it in. `.env` is git-ignored: never commit it.
# Every value here is a placeholder. Use credentials generated for THIS deployment.

# --- Required for any real deployment ---------------------------------------------------------
# Signs room tickets. At least 32 random characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated for each process (fine for a quick try-out, but every restart
# invalidates open rooms).
SECRET_KEY=

# --- Video (Agora) -----------------------------------------------------------------------------
# From your own project in the Agora console. Without both values the UI works, but the lobby
# disables "Join room" and says video is not configured.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Network -----------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8550

# Host names this server answers to. Requests (and WebSocket upgrades) with any other Host/Origin are
# refused, which blocks DNS rebinding and cross-site WebSocket hijacking. Add your public hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Public origin of the site, e.g. https://chat.example.com. Used to build the room iframe URL, so set it
# whenever a proxy sits in front of the app. Must start with http:// or https://.
PUBLIC_BASE_URL=

# true/false. Adds Strict-Transport-Security (1 year, includeSubDomains). Defaults to true when
# PUBLIC_BASE_URL starts with https://. Browsers only allow camera/microphone on https:// or localhost.
HTTPS=

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto uvicorn may trust: comma-separated IPs, or *
# Only trust a proxy you control, otherwise clients can spoof their address and dodge the login throttle.
TRUSTED_PROXIES=

# Extra origins the room page may connect to (comma-separated CSP connect-src entries). Agora's own
# hosts (*.agora.io, *.sd-rtn.com, *.agoraio.cn) are already allowed. Add entries only if the browser
# console reports a blocked Agora connection, e.g. a custom proxy or private deployment domain.
CSP_CONNECT_SRC_EXTRA=

# --- Storage -----------------------------------------------------------------------------------
# SQLAlchemy URL. Default: sqlite:///<this folder>/data/videochat.sqlite3
DATABASE_URL=

# --- Tuning (the defaults are sensible) ---------------------------------------------------------
# SESSION_TTL_SECONDS=604800          # absolute login lifetime (7 days), 300 .. 7776000
# SESSION_IDLE_TTL_SECONDS=86400      # sign out after this long without activity (24 h), 300 .. 2592000
# RTC_TOKEN_TTL_SECONDS=3600          # Agora token lifetime (1 h); renewed automatically, 60 .. 86400
# ROOM_TICKET_TTL_SECONDS=21600       # how long one room entry stays valid (6 h), 60 .. 86400
# SCRYPT_N=32768                      # password hashing cost, a power of two >= 16384
